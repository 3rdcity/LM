# Copy to .env (or set these in your host's dashboard).

# Public address of the site, used in share links, the sitemap and social cards.
SITE_URL=https://leyam.example

# Admin login at /admin. Admin stays switched off until this is set.
ADMIN_PASSWORD=
# Long random string. Keeps admin logins alive across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contact form email. Without these, messages still land in /admin/messages.
CONTACT_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or a single URL instead of the four above: smtps://user:pass@smtp.example.com:465
# SMTP_URL=

# Hosted donation checkout (Stripe Payment Link, PayPal, Givebutter...).
# Until set, the Donate button opens the contact form on the foundation topic.
DONATE_URL=

# Where posts, messages, subscribers and uploads are stored. Must be persistent.
# DATA_DIR=./data

# Set to "true" (or a hop count) when running behind a proxy or load balancer,
# so secure cookies and the login rate limit see the real client.
# TRUST_PROXY=true

PORT=3000
